                </bekendmaking>
              </bron>
            </inwerkingtreding>
            <opmerkingen>
              <opmerking type="Inwtr">
                <al>De wijziging is van toepassing voor belastingen premieschulden die
    betrekking hebben op werk dat is verricht na de inwerkingtreding van
    deze   wet.</al>
              </opmerking>
