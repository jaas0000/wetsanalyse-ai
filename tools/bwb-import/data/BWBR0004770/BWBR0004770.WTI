                  <publicatienummer>431</publicatienummer>
                </bekendmaking>
              </bron>
            </ontstaansbron>
            <inwerkingtreding>
              <bron xsi:type="bron_groot" type="oorspronkelijk">
                <ondertekening>2026-06-24</ondertekening>
                <bekendmaking soort="Stb" urlidentifier="stb-2026-159">
                  <publicatiedatum>2026-06-29</publicatiedatum>
                  <publicatiejaar>2026</publicatiejaar>
                  <publicatienummer>159</publicatienummer>
                </bekendmaking>
              </bron>
            </inwerkingtreding>
            <opmerkingen>
              <opmerking type="Inwtr">
                <al>Treedt in werking op het tijdstip waarop de Wet toelating
    terbeschikkingstelling van arbeidskrachten in werking treedt, met
    dien verstande dat het eerste lid eerst toepassing     vindt met
    betrekking tot belastingtijdvakken die zijn aangevangen op     of na
    dat tijdstip.</al>
              </opmerking>
            </opmerkingen>
          </details>
        </datum>
      </regelingelement>
