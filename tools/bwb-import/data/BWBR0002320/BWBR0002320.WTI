                  <publicatiejaar>2010</publicatiejaar>
                  <publicatienummer>363</publicatienummer>
                </bekendmaking>
              </bron>
            </ontstaansbron>
            <inwerkingtreding>
              <bron xsi:type="bron_groot" type="oorspronkelijk">
                <ondertekening>2010-09-23</ondertekening>
                <bekendmaking soort="Stb" urlidentifier="stb-2010-387">
                  <publicatiedatum>2010-10-01</publicatiedatum>
                  <publicatiejaar>2010</publicatiejaar>
                  <publicatienummer>387</publicatienummer>
                </bekendmaking>
              </bron>
            </inwerkingtreding>
            <opmerkingen>
              <opmerking type="Alg">
                <al>Abusievelijk geeft het Staatsblad een wijzigingsopdracht voor het vierde lid in plaats van het derde lid.</al>
              </opmerking>
              <opmerking type="Inwtr">
                <al>Treedt in werking op het tijdstip waarop artikel I, tweede lid, van de 
Rijkswet wijziging Statuut in verband met de opheffing van de Nederlandse 
Antillen in werking treedt.</al>
              </opmerking>
            </opmerkingen>
          </details>
        </datum>
