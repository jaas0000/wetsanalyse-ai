                <bekendmaking soort="Stb" urlidentifier="stb-2017-83">
                  <publicatiedatum>2017-03-13</publicatiedatum>
                  <publicatiejaar>2017</publicatiejaar>
                  <publicatienummer>83</publicatienummer>
                </bekendmaking>
              </bron>
            </inwerkingtreding>
            <opmerkingen>
              <opmerking type="Alg">
                <al> Abusievelijk geeft de Staatscourant een inwerkingtreding voor
    artikel I, onderdeel T, in plaats van artikel I, onderdeel P.</al>
              </opmerking>
            </opmerkingen>
          </details>
        </datum>
      </regelingelement>
