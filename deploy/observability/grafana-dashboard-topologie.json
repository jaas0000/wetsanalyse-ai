        "h": 12,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "id": 5,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "wa-tempo"
          },
          "filters": [
            {
              "id": "service-name",
              "operator": "=",
              "scope": "resource",
              "tag": "service.name"
            }
          ],
          "limit": 20,
          "query": "{}",
          "queryType": "traceqlSearch",
          "refId": "A",
          "tableType": "traces"
        }
      ],
      "title": "Volg één executie (traces)",
      "type": "table"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "wa-loki"
      },
      "description": "Live logregels van alle onderdelen. Klik een regel → veld TraceID linkt door naar de trace in Tempo (correlatie op trace_id).",
