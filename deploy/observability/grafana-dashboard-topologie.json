          },
          "queryType": "serviceMap",
          "refId": "A"
        }
      ],
      "title": "Topologie (service-graph)",
      "type": "nodeGraph"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "wa-tempo"
      },
