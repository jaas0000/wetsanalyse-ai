          "datasource": {
            "type": "prometheus",
            "uid": "wa-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(increase(traces_service_graph_request_failed_total[15m])) or vector(0)",
          "instant": true,
          "legendFormat": "keten-fouten",
          "range": false,
          "refId": "Fouten"
        }
