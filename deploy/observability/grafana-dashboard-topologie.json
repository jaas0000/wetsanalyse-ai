      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "wa-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(increase(traces_service_graph_request_total{client=\"wetsanalyse-frontend\"}[15m])) or vector(0)",
          "instant": true,
          "legendFormat": "Frontend",
          "range": false,
          "refId": "Frontend"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "wa-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(increase(http_server_duration_milliseconds_count{exported_job=\"wetsanalyse-api\"}[15m])) or vector(0)",
          "instant": true,
          "legendFormat": "API",
          "range": false,
          "refId": "API"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "wa-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(increase(traces_service_graph_request_total{client=\"wetsanalyse-api\", connection_type=\"database\"}[15m])) or vector(0)",
          "instant": true,
          "legendFormat": "Postgres",
          "range": false,
          "refId": "Postgres"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "wa-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(increase(traces_spanmetrics_calls_total{span_name=\"POST /v1/chat\"}[15m])) or vector(0)",
