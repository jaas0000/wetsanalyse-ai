# Kopieer dit bestand naar .env.local en vul de waarden in.

# Graph-QA agent (productie)
CHAT_API_URL=https://graph-qa.ipalm.nl
CHAT_API_TOKEN=

# Wetsanalyse backend API (voor authenticatie)
API_BASE_URL=https://wetsanalyse-api.ipalm.nl
API_TOKEN=

# Next-Auth (v5: AUTH_SECRET + AUTH_URL — niet NEXTAUTH_* meer)
AUTH_URL=http://localhost:3001
AUTH_SECRET=vervang-dit-met-openssl-rand-base64-32

# Publieke URL wetsanalyse-webapp (voor links in AccountPanel)
NEXT_PUBLIC_WEBAPP_URL=https://wetsanalyse.ipalm.nl
