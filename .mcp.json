{
  "mcpServers": {
    "wetsanalyse-admin": {
      "command": "node",
      "args": ["tools/wetsanalyse-admin-mcp/dist/index.js"],
      "env": {
        "WETSANALYSE_ADMIN_API_URL": "https://wetsanalyse-api.ipalm.nl",
        "WETSANALYSE_ADMIN_TOKEN": "${WETSANALYSE_ADMIN_TOKEN}"
      }
    },
    "proxmox": {
      "command": "node",
      "args": ["tools/proxmox-mcp/dist/index.js"],
      "env": {
        "PROXMOX_URL": "https://proxmox.ipalm.nl",
        "PROXMOX_TOKEN_ID": "mcp@pve!claude",
        "PROXMOX_TOKEN_SECRET": "${PROXMOX_TOKEN_SECRET}",
        "PROXMOX_NODE": "pve01"
      }
    },
    "grafana": {
      "command": "docker",
      "args": [
        "run", "--rm", "-i",
        "-e", "GRAFANA_URL",
        "-e", "GRAFANA_SERVICE_ACCOUNT_TOKEN",
        "mcp/grafana", "-t", "stdio"
      ],
      "env": {
        "GRAFANA_URL": "https://grafana.ipalm.nl",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "${GRAFANA_TOKEN}"
      }
    }
  }
}
